{
  "name": "start_mission",
  "description": "Menu chính -> PLAY -> ô LOBBY -> chờ tải -> trong lobby bấm ô PLAY lớn. Template: 'lobby_play_button' = chữ PLAY trên menu chính KÈM một phần chữ CUSTOMIZATION bên dưới (để không nhầm với ô PLAY trong lobby), anchor_y 0.3 = bấm vào phần chữ PLAY ở trên; 'lobby_card' = ô LOBBY; 'mission_play_button' = ô PLAY lớn trong lobby (khung viền cam, dòng N/A phía trên). 'missions_card' = thẻ MISSIONS (chụp tiêu đề MISSIONS kèm phần trên của hình). 'create_button' = nút CREATE (vàng) để tạo phòng nhiệm vụ. 'forest_map' = CHỈ chữ FOREST (không lấy dòng REWARD BOOST vì đồng hồ thay đổi).",
  "steps": [
    {
      "action": "log",
      "message": "Menu chính: bấm PLAY"
    },
    {
      "action": "click_image",
      "template": "lobby_play_button",
      "anchor_y": 0.3,
      "timeout": 15
    },
    {
      "action": "wait",
      "seconds": 1.5
    },
    {
      "action": "log",
      "message": "Chọn LOBBY"
    },
    {
      "action": "click_image",
      "template": "lobby_card",
      "timeout": 15
    },
    {
      "action": "wait",
      "seconds": 2.0
    },
    {
      "action": "wait_image_gone",
      "template": "lobby_card",
      "timeout": 60,
      "optional": true
    },
    {
      "action": "log",
      "message": "Trong lobby: bấm PLAY"
    },
    {
      "action": "click_image",
      "template": "mission_play_button",
      "timeout": 60
    },
    {
      "action": "wait",
      "seconds": 2.0
    },
    {
      "action": "log",
      "message": "Chọn MISSIONS"
    },
    {
      "action": "click_image",
      "template": "missions_card",
      "timeout": 20
    },
    {
      "action": "wait",
      "seconds": 1.5
    },
    {
      "action": "log",
      "message": "Chọn map FOREST"
    },
    {
      "action": "click_image",
      "template": "forest_map",
      "timeout": 20
    },
    {
      "action": "wait",
      "seconds": 1.5
    },
    {
      "action": "log",
      "message": "Bấm CREATE"
    },
    {
      "action": "click_image",
      "template": "create_button",
      "timeout": 20
    },
    {
      "action": "wait",
      "seconds": 1.5
    }
  ]
}